# a_route.scr
# Runs stage 1 of the refill/ripup/autoroute helper.
#
# Stage 1 (a_route.ulp): finds the two GND fill polygons (Top + Bottom),
# renames them to 'FILL', and rips up all routing.
#
# AUTO is NOT run by this script (or by a_route.ulp). EAGLE only lets you
# review/pick the Autorouter's job variants (Evaluate / End Job) when AUTO
# is typed directly at the keyboard - queuing it from a script or ULP
# causes it to auto-commit a variant instead of letting you choose.
#
# After this script finishes:
#   1. Type AUTO; yourself on the command line and pick the best variant.
#   2. Then run: RUN a_route_finish.ulp;
#      (renames the polygons back to 'GND', fits the window, sets the
#      standard layer set, runs RATSNEST, and saves the board)
#
# Run from the Board Editor command line with: SCRIPT a_route.scr;

RUN a_route.ulp;
